+                            style = MaterialTheme.typography.labelSmall,
+                            modifier = Modifier.align(Alignment.BottomStart).padding(6.dp)
+                                .clip(RoundedCornerShape(4.dp)).background(Color.Black.copy(alpha = 0.7f))
