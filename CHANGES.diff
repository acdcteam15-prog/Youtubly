+/** YouTube's long-press / ⋮ bottom sheet. */
+@OptIn(ExperimentalMaterial3Api::class)
+@Composable
+private fun VideoActionsSheet(video: Video, title: String, onDismiss: () -> Unit, onRemoved: (String) -> Unit) {
