<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon. Each opens MainActivity with a youtubly:// link (see handleIntent). -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut android:shortcutId="search" android:enabled="true"
        android:icon="@drawable/ic_shortcut_search"
        android:shortcutShortLabel="@string/shortcut_search_short"
        android:shortcutLongLabel="@string/shortcut_search_long">
        <intent android:action="android.intent.action.VIEW" android:data="youtubly://search"
            android:targetPackage="com.youtubly.app" android:targetClass="com.youtubly.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="continue" android:enabled="true"
        android:icon="@drawable/ic_shortcut_continue"
        android:shortcutShortLabel="@string/shortcut_continue_short"
        android:shortcutLongLabel="@string/shortcut_continue_long">
        <intent android:action="android.intent.action.VIEW" android:data="youtubly://continue"
            android:targetPackage="com.youtubly.app" android:targetClass="com.youtubly.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="downloads" android:enabled="true"
        android:icon="@drawable/ic_shortcut_downloads"
        android:shortcutShortLabel="@string/shortcut_downloads_short"
        android:shortcutLongLabel="@string/shortcut_downloads_long">
        <intent android:action="android.intent.action.VIEW" android:data="youtubly://downloads"
            android:targetPackage="com.youtubly.app" android:targetClass="com.youtubly.app.MainActivity" />
    </shortcut>
    <shortcut android:shortcutId="audio" android:enabled="true"
        android:icon="@drawable/ic_shortcut_audio"
        android:shortcutShortLabel="@string/shortcut_audio_short"
        android:shortcutLongLabel="@string/shortcut_audio_long">
        <intent android:action="android.intent.action.VIEW" android:data="youtubly://audio"
            android:targetPackage="com.youtubly.app" android:targetClass="com.youtubly.app.MainActivity" />
    </shortcut>
</shortcuts>
